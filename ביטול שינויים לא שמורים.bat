@echo off
chcp 65001 >nul
set "PATH=%LOCALAPPDATA%\Programs\Git\cmd;%PATH%"
echo ========================================================
echo       ביטול שינויים אחרונים שלא נשמרו (חזרה אחורה)
echo ========================================================
echo.
echo שינויים שקיימים כרגע וטרם נשמרו בגרסה:
git status -s
echo.
set /p confirm="האם את בטוחה שברצונך לבטל את כל השינויים שבוצעו מאז השמירה האחרונה? (הקלידי Y לאישור): "
if /i "%confirm%"=="Y" (
    git restore .
    git clean -fd
    echo.
    echo כל השינויים בוטלו בהצלחה והפרויקט חזר לגרסה השמורה האחרונה!
) else (
    echo.
    echo הפעולה בוטלה, שום דבר לא נמחק.
)
echo ========================================================
pause
